<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Dog Breed Picker</masterLabel>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="breedName" type="String" label="Breed Name" role="outputOnly"/>
            <property name="minLife" type="Integer" label="Minimum Life" role="outputOnly"/>
            <property name="maxLife" type="Integer" label="Maximum Life" role="outputOnly"/>
            <property name="description" type="String" label="Description" role="outputOnly"/>
            <property name="hypoallergenic" type="Boolean" label="Hypoallergenic" role="outputOnly"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>